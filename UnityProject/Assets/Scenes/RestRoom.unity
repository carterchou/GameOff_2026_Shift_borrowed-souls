  m_Name: 
  m_EditorClassIdentifier: BorrowedSouls.Runtime::BorrowedSouls.UI.LoadingScreen
  _group: {fileID: 1599950644}
  _tip: {fileID: 1914120894}
  _bar: {fileID: 2133414071}
  _soul: {fileID: 1254039061}
  _tips:
  - "\u53EA\u6709\u88AB\u4F60\u6253\u5012\u7684\u8EAB\u9AD4\uFF0C\u624D\u6703\u7559\u4E0B\u53EF\u4EE5\u501F\u7528\u7684\u5C4D\u9AD4\u3002"
  - "\u5C4D\u9AD4\u53EA\u7559 10 \u79D2\uFF0C\u8D81\u5B83\u6D88\u6563\u524D\u98DB\u9032\u53BB\u3002"
  - "\u6BCF\u5177\u8EAB\u9AD4\u53EA\u6709\u7B2C\u4E00\u6B21\u501F\u7528\u6642\u6703\u56DE\u8840\uFF0C\u56DE\u5230\u820A\u8EAB\u9AD4\u4E0D\u6703\u3002"
  - "\u904A\u9B42\u7684\u6642\u9593\u6709\u9650\u3002\u5012\u6578\u7D50\u675F\u524D\uFF0C\u4E00\u5B9A\u8981\u627E\u5230\u4E0B\u4E00\u5177\u8EAB\u9AD4\u3002"
  - "\u64BF\u9B42\u71FC\u6703\u56DE\u4E00\u9EDE\u8840\uFF0C\u6E05\u5B8C\u4E00\u6CE2\u4E5F\u6703\u56DE\u8840\u3002"
  - "\u6BCF\u4E00\u5C40\u90FD\u6703\u62FF\u5230\u9B42\u6676\uFF0C\u56DE\u4F11\u606F\u5BA4\u53EF\u4EE5\u8CB7\u5929\u8CE6\uFF0C\u4E0B\u4E00\u5C40\u5C31\u751F\u6548\u3002"
  - "\u8840\u91CF\u5920\u4F4E\u7684\u6D3B\u6575\u4E5F\u80FD\u76F4\u63A5\u4FB5\u5165\uFF0C\u5347\u7D1A\u53EF\u4EE5\u653E\u5BEC\u9580\u6ABB\u3002"
  - "\u7CBE\u82F1\u6703\u8D70\u53BB\u8E29\u788E\u5730\u4E0A\u7684\u5C4D\u9AD4\uFF0C\u60F3\u501F\u8981\u5FEB\u3002"
  - "\u9583\u907F\u9014\u4E2D\u4E0D\u6703\u53D7\u50B7\uFF0C\u770B\u6E96\u6575\u4EBA\u51FA\u624B\u518D\u6309\u3002"
  - "\u528D\u58EB\u8FD1\u6230\u3001\u5F13\u624B\u9060\u5C04\u3001\u6CD5\u5E2B\u7BC4\u570D\u3002\u63DB\u4E00\u5177\u8EAB\u9AD4\uFF0C\u5C31\u63DB\u4E00\u7A2E\u6253\u6CD5\u3002"
  _minSeconds: 2.2
  _fadeInSeconds: 0.25
